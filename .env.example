# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Required ─────────────────────────────────────────────────────────────
POSTGRES_USER=recoverright
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=recoverright
DATABASE_URL=postgresql://recoverright:your_password_here@127.0.0.1:5433/recoverright

# Diagnosis LLM. Free key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Razorpay TEST-mode credentials. Never put a live (rzp_live_) key here.
RAZORPAY_KEY_ID=your_rzp_test_key_here
RAZORPAY_KEY_SECRET=your_rzp_test_secret_here

# Webhook signing secret, from Razorpay Dashboard → Settings → Webhooks.
# POST /api/webhooks/razorpay verifies every delivery against this with
# HMAC-SHA256. Unset, the endpoint returns 503 rather than accepting an
# unauthenticated delivery — Razorpay then retries, so nothing is lost.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Optional ─────────────────────────────────────────────────────────────
# Everything below has a working default; uncomment only to override.

# Dashboard origin(s) allowed to call this API, comma-separated. An explicit
# allowlist rather than "*" — this API creates payment links.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# LOG_LEVEL=INFO

# ── LLM request pacing ───────────────────────────────────────────────────
# Two different limits, and both are needed. MAX_CONCURRENCY bounds requests
# in flight; MIN/MAX_REQUEST_INTERVAL bound the rate at which requests
# *start*, which is what a rate limit actually measures. Raise the interval
# (or lower the concurrency) if a batch is still collecting 429s; the pacer
# widens on its own when it sees one and decays back on sustained success.
# NVIDIA_MAX_CONCURRENCY=4
# NVIDIA_MIN_REQUEST_INTERVAL=0.4
# NVIDIA_MAX_REQUEST_INTERVAL=4.0
# NVIDIA_MAX_RETRIES=6
# NVIDIA_BACKOFF_BASE_SECONDS=1.5
# NVIDIA_BACKOFF_MAX_SECONDS=45.0
# NVIDIA_REQUEST_TIMEOUT_SECONDS=30.0
# NVIDIA_INTRA_DIAGNOSIS_DELAY=0.5

# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Razorpay client ──────────────────────────────────────────────────────
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# RAZORPAY_TIMEOUT_SECONDS=15

# ── Dashboard build ──────────────────────────────────────────────────────
# Read by Vite at build time (frontend/), not by the Python services. Point a
# built dashboard at an API other than a local uvicorn.
# VITE_API_BASE_URL=http://localhost:8000
